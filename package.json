{
  "name": "grupon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "e2e": "playwright test --config e2e/playwright.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "turbo run gen",
    "lint": "turbo run lint",
    "lighthouse": "lhci autorun --config apps/web/lighthouserc.cjs",
    "seed": "turbo run seed",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
