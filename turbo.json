{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["GOCACHE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "gen": {
      "cache": false,
      "dependsOn": ["^gen"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "seed": {
      "cache": false,
      "env": ["APP_ENV", "DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
