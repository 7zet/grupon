# Copy privately to .env.production. All values below are placeholders, never real credentials.
APP_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
VOUCHER_QR_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
PAYMENT_MOCK_ENABLED=false
MANUAL_PAYMENT_ENABLED=false
MANUAL_PAYMENT_HOLD=24h
MANUAL_PAYMENT_INSTRUCTIONS=Bank transfer details will be provided by support. Include your order number.
SMS_PROVIDER=log
WEB_PUBLIC_URL=https://example.com
MEDIA_PUBLIC_BASE=https://example.com/media
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com
