# Local demo settings. Copy this file to .env.local (it is git-ignored) and edit if needed.
# scripts/demo.ps1 reads .env.local and passes every value to the API and the web app.
# All values here are for a demo on your own PC. Never put real secrets in this file's example.

# --- Mode ---------------------------------------------------------------------------------------
APP_ENV=development            # keep "development" for the demo (real production needs "production" + Redis)
DEMO_MODE=true                 # shows the sign-in code on screen, enables test-payment buttons and the Demo badge
RUN_WORKER_IN_API=true         # background jobs run inside the API process (one less window)

# --- Addresses ----------------------------------------------------------------------------------
SITE_URL=http://localhost:3000             # public address of the site; for ngrok use the https URL (see docs/SHARE.md)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # extra origins allowed to send cookie-authenticated changes
WEB_PORT=3000
API_ADDR=:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1   # the web SERVER calls the API here; browsers never do
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=dev_revalidate_secret
INTERNAL_API_TOKEN=dev_internal_token

# --- Database (local PostgreSQL, see docs/ENVIRONMENT.md and scripts/dev-db.sh) -----------------
DATABASE_URL=postgres://app:app_dev_password@localhost:5433/app?sslmode=disable
# Used only by the Go tests:
TEST_DATABASE_URL=postgres://app:app_dev_password@localhost:5433/app?sslmode=disable

# --- Secrets (development values; the API uses safe defaults in development when these are unset) -
# JWT_SECRET=at-least-32-characters-long-dev-secret
# VOUCHER_QR_SECRET=at-least-32-characters-long-dev-qr
PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_WEBHOOK_SECRET=dev-only-insecure-mock-webhook-0123456789
MANUAL_PAYMENT_ENABLED=false

# --- Files and media ------------------------------------------------------------------------------
# MEDIA_LOCAL_DIR=
# MEDIA_PUBLIC_BASE=http://localhost:8080/media
# DOCUMENTS_LOCAL_DIR=

# --- SMS and email -------------------------------------------------------------------------------
SMS_PROVIDER=log               # "log" works only with DEMO_MODE=true; the code is shown on screen
SMS_DAILY_CAP_PER_IP=50
SMS_DAILY_CAP_GLOBAL=1000
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_SENDER=
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api
SMTP_HOST=                     # empty = emails are only logged
SMTP_PORT=1025
SMTP_FROM=no-reply@local.test

# --- Help page: support contacts (demo values; leave empty to hide a channel) ---------------------
SUPPORT_PHONE=+998 71 200 00 00
SUPPORT_TELEGRAM=@grupon_support
SUPPORT_EMAIL=support@grupon.example

# --- Optional -----------------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0   # needed only with APP_ENV=production
# TRUST_PROXY_HEADERS=false
BRAND_NAME=Grupon
LOG_LEVEL=info
