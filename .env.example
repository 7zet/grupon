# Copy this file to .env for local development. These credentials are local-only.

# Applications
APP_ENV=development
API_ADDR=:8080
API_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
USE_MSW=false
NEXT_PUBLIC_USE_MSW=false
# Set both to true only to develop without the API (MSW mocks from apps/web/src/mocks).
# Shared secret the API sends in X-Revalidate-Secret to POST /api/revalidate. Dev value only.
WEB_REVALIDATE_SECRET=dev_revalidate_secret
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
INTERNAL_API_TOKEN=dev_internal_token

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app_dev_password@localhost:5432/app?sslmode=disable

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_PORT=6379
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# S3-compatible object storage (MinIO locally)
MINIO_ROOT_USER=localadmin
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY=localadmin
S3_SECRET_KEY=minio_dev_password
S3_USE_PATH_STYLE=true

# Local email capture (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=1000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@local.test

# Browser/API boundaries
CORS_ALLOWED_ORIGINS=http://localhost:3000
